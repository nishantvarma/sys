# the tmux half of sys: the bindings that run sys's own scripts, kept
# beside them so a trigger and its program cannot drift apart. the
# prefix, the status line and the rest stay in your own tmux.conf,
# which reaches this with
#
#	source-file ~/src/sys/tmux/conf

# a path has to be one word for p to be handed a whole address. with
# the default set, the word under ed/2-motion/04-fwd.go:12 is `motion`.
set -g word-separators " "

# a view can only decline to speak if it knows nobody is looking: fm writes
# cur on every row and must not do it from a background pane. tmux tells a
# pane it gained or lost the eye only with this on.
set -g focus-events on

# left click is select and nothing else — p -c stops at cur. acme's three
# buttons, and the two beside it were already here (design/mouse). the
# guard is DoubleClick1Pane's: a mode with a table of its own and a
# mouse-reading program keep theirs, and the drag that selects text still
# runs after this.
bind-key -n MouseDown1Pane {
	select-pane -t =
	if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" "send-keys -M" {
		set-option -pF @p "#{mouse_word}"
		run-shell -b "p #{pane_id} -c"
		send-keys -M
	}
}

# copy mode is such a table, and what it keeps is select-pane alone: said
# again there, the scrollback answers like the live screen.
bind-key -T copy-mode-vi MouseDown1Pane {
	select-pane -t =
	set-option -pF @p "#{mouse_word}"
	run-shell -b "p #{pane_id} -c"
}

# a drag ends where tmux ends it — mouse-up, mode closed — and says its
# selection on the way out. held open to be told p, a drag meant for
# anything else had to be dismissed by hand. what it selected is X's
# primary selection too, as a selection is anywhere on X, through xclip:
# st takes no OSC 52 from tmux, built as it is; off X, p is told all the
# same. a copy in copy mode is X's clipboard.
bind-key -T copy-mode-vi MouseDragEnd1Pane {
	send-keys -X copy-pipe-and-cancel \
		'x=$(cat); printf %s "$x" | xclip; printf %s "$x" |
		p #{pane_id} -c -'
}
set -s copy-command "xclip -selection clipboard"

# open what the text names — sh/p. the word travels in a pane option,
# never in the command, so screen text is never read as a shell one.
bind-key -n MouseDown3Pane if-shell -F "#{mouse_any_flag}" "send-keys -M" {
	set-option -pF @p "#{mouse_word}"
	run-shell -b "p #{pane_id}"
}
bind-key -T copy-mode-vi p if-shell -F "#{selection_present}" {
	send-keys -X copy-pipe-and-cancel "p #{pane_id} -"
} {
	set-option -pF @p "#{copy_cursor_word}"
	run-shell -b "p #{pane_id}"
}
bind-key -T copy-mode-vi MouseDown3Pane if-shell -F "#{selection_present}" {
	send-keys -X copy-pipe-and-cancel "p #{pane_id} -"
} {
	set-option -pF @p "#{mouse_word}"
	run-shell -b "p #{pane_id}"
}

# a double-tap needs no second finger, so it's the touchpad's right click.
# skips tmux's own select-word+delay (only there to make room for a
# triple-click); mouse_word gets the word straight away, same as above. no
# select-pane — the click that opened the double has already made it.
bind-key -n DoubleClick1Pane if-shell -F "#{mouse_any_flag}" "send-keys -M" {
	set-option -pF @p "#{mouse_word}"
	run-shell -b "p #{pane_id}"
	send-keys -M
}

# and in copy mode, where tmux's own selects the word, copies it and closes
# the mode you had just scrolled into.
bind-key -T copy-mode-vi DoubleClick1Pane {
	set-option -pF @p "#{mouse_word}"
	run-shell -b "p #{pane_id}"
}

# said from anywhere: the last word said is still in @p, so the verb needs
# no mode, no prompt and no pane that is listening. displaces
# previous-window, which Tab already covers.
bind-key p run-shell -b "p #{pane_id}"
bind-key a run-shell -b "p #{pane_id} -a"

# the same word as an argument, not a destination: it lands at the prompt
# of the marked pane, else the frame's shell, else the last one, and
# waits. no Enter is sent, so screen text still becomes a command only
# when you say so (design/mouse).
bind-key -n MouseDown2Pane if-shell -F "#{mouse_any_flag}" "send-keys -M" {
	set-option -pF @p "#{mouse_word}"
	run-shell -b "p #{pane_id} -a"
}
bind-key -T copy-mode-vi a if-shell -F "#{selection_present}" {
	send-keys -X copy-pipe-and-cancel "p #{pane_id} -a -"
} {
	set-option -pF @p "#{copy_cursor_word}"
	run-shell -b "p #{pane_id} -a"
}
bind-key -T copy-mode-vi MouseDown2Pane if-shell -F "#{selection_present}" {
	send-keys -X copy-pipe-and-cancel "p #{pane_id} -a -"
} {
	set-option -pF @p "#{mouse_word}"
	run-shell -b "p #{pane_id} -a"
}

# a frame's bar, the border over a slot of tabs, is a button, the same
# three as in a pane (studio/cheatsheet): left opens tmux's own menu of the
# slot's tabs at its left, where a tab is picked by a click or its
# number, and the panel's has a new terminal, a close and a hide; right
# the next tab; middle a new terminal, as l new opens one. tmux says no
# column for a press on a border, so a tab's name is no button of its own
# there, and the menu is; a press on any other border is tmux's own.
bind-key -n MouseDown1Border if-shell -F "#{@bar}" {
	run-shell -b "studio tab -t #{pane_id} menu #{client_name}"
} {
	select-pane -M
}
bind-key -n MouseDown3Border if-shell -F "#{@bar}" {
	run-shell -b "studio tab -t #{pane_id} next"
}
bind-key -n MouseDown2Border if-shell -F "#{@frame}" {
	run-shell -b -c "#{pane_current_path}" "studio tab -t #{pane_id} new"
}

# alt-t hides a frame's panel, its terminals, and shows it again: t, the
# terminals. a run-shell job has no pane of its own, so the binding names
# the one pressed in
bind-key -n M-t if-shell -F "#{@studio-frame}" {
	run-shell -b "studio panel -t #{pane_id}"
} {
	send-keys M-t
}

# the layout, main-vertical: the shell master, the rest stacked beside
# it. a window is laid out again when its panes change in number, a split,
# a kill or an exit, and no other window is: a hand resize keeps, for it
# changes no count. the hook names its own window, for one that ended
# whole would be run on the window looked at; studio empties it on a
# frame's window, which keeps its own layout.
set -g main-pane-width 50%
set-hook -g window-layout-changed {
	if-shell -F "#{==:#{window_id},#{hook_window}}" {
		if-shell -F "#{!=:#{window_panes},#{@panes}}" {
			set -wF @panes "#{window_panes}"
			select-layout main-vertical
		}
	}
}
bind-key Enter swap-pane -d -t '{top-left}'

# the pointer follows the pane — sh/warp. tmux cannot move it, so X does,
# and never when the pointer is already in that pane: the click that
# selected one must not be dragged off the word under it.
set-hook -g after-split-window "run-shell -b warp"
set-hook -g after-select-pane "run-shell -b warp"
