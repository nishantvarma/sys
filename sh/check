#!/usr/bin/env bash

# check [target]...
#
# every check the tree ships, one run: references open (general/reference),
# lines fit (layout/vertical), prose has no title case (general/naming/case), a
# page holds together (general/addressability, layout/sections) and
# carries a skeleton's style and engine (general/medium).
# run from the tree root.
#
#	stdout	violations, path:line first. plumbable.
#	exit	1 if dirty

set -u

[ $# -eq 0 ] && set -- .

files=$(find -L "$@" -type f | sed 's|^\./||' | sort)
[ -n "$files" ] || { echo "check: no files in $*" >&2; exit 2; }
# html and markdown are exempt, and so is a file whose lines are items a
# program owns: go.sum is go's, a keep list is rsync's, one path a line
wide=$(echo "$files" | grep -v '\.\(html\|md\)$' |
	grep -v '\(^\|/\)\(go\.sum\|keep\)$')
# a leaf has no extension; a dotted name is code, except these two, and
# so is a script: #! on its first line
prose=$(awk 'FNR == 1 && !/^#!/ {print FILENAME} {nextfile}' \
	$(echo "$files" | grep -v '\.[^/]*$') /dev/null)
md=$(echo "$files" | grep '\.md$')
html=$(echo "$files" | grep '\.html$')

rc=0
ref -x general/reference "$@" 2>&1 >/dev/null || rc=1
# a line fits in 79 columns as a terminal shows it: a rune is one column,
# however many bytes it takes, and a tab runs on to the next multiple of 8
LC_ALL=C awk '{
	s = $0
	gsub(/[\200-\277]/, "", s)
	while (i = index(s, "\t")) {
		pad = sprintf("%" (8 - (i - 1) % 8) "s", "")
		s = substr(s, 1, i - 1) pad substr(s, i + 1)
	}
}
length(s) > 79 {print FILENAME":"FNR; bad=1} END {exit bad}' $wide \
	/dev/null || rc=1
# prose is in sentence case, so title case is what breaks it: three
# capitalized words in a row. a `code span` is spelling not ours to fix
title='[A-Z][a-z]+ [A-Z][a-z]+ [A-Z][a-z]+'
{
	awk -v t="$title" '{s = $0; gsub(/`[^`]*`/, "", s)}
	s ~ t {print FILENAME":"FNR":"$0}' $prose $md /dev/null
	# style, script and pre are code, and so is a <code> span
	awk -v t="$title" '/<(style|script|pre)[ >]/ {code=1}
	{s = $0; gsub(/<code>[^<]*<\/code>/, "", s)}
	!code && s ~ t {print FILENAME":"FNR":"$0}
	/<\/(style|script|pre)>/ {code=0}' $html /dev/null
} | grep -v '~/' && rc=1
awk -v want=' head tokens style local content engine' '
function done(  k) {
	for (k = 1; k <= n; k++)
		if (!(ref[k] in id)) print f ":" at[k] ": no id: " ref[k]
	if (marks && seq != want)
		print f ":1: sections:" seq ", not" want
}
FNR == 1 { if (NR > 1) done(); f = FILENAME; n = marks = 0; seq = ""
	delete id }
{
	s = $0
	while (match(s, / id="[^"]*"/)) {
		k = substr(s, RSTART + 5, RLENGTH - 6)
		if (k in id) print f ":" FNR ": duplicate id: " k
		id[k]; s = substr(s, RSTART + RLENGTH)
	}
	s = $0
	while (match(s, /href="#[^"]+"/)) {
		ref[++n] = substr(s, RSTART + 7, RLENGTH - 8); at[n] = FNR
		s = substr(s, RSTART + RLENGTH)
	}
	s = $0
	while (match(s, /-- [a-z]+ --/)) {
		k = substr(s, RSTART + 3, RLENGTH - 6); marks++
		if (index(want " ", " " k " ")) seq = seq " " k
		s = substr(s, RSTART + RLENGTH)
	}
}
END { if (NR) done() }' $html /dev/null | grep . && rc=1
# a page's style and engine are a skeleton's, verbatim: copies drift unless
# compared. what the page adds sits under local, outside the comparison.
# skel copies them back in.
medium=$(dirname "$(readlink -f "$0")")/../medium
# prettier indents what sits inside style and script, marks included
style='/^ *\/\* -- tokens -- \*\/$/,/^ *\/\* -- local -- \*\/$/'
engine='/^ *\/\/ -- engine --$/,$'
for f in $html; do
	for part in style engine; do
		p=$(sed -n "${!part}p" "$f")
		[ -n "$p" ] || continue
		for s in "$medium"/*.html; do
			[ "$p" = "$(sed -n "${!part}p" "$s")" ] && continue 2
		done
		at=$(sed -n "${!part}{=;q}" "$f")
		echo "$f:$at: $part is no skeleton's"
		rc=1
	done
done
exit $rc
