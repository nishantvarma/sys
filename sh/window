#!/usr/bin/env wish
# window: an outline drawn by Tk, the view at the other end of a program's
# pipe, as fm -w starts it. A message is a JSON object a line. In come
# draw, the tree and the status, and ask, a prompt; out go key, a key's
# name or a click on a node by its id, answer, a prompt's line, and size.

package require Tk

# -- reading JSON: an object is a dict, an array a list, true 1, false
# and null 0; a view needs no more to read what comes in

proc json {s} {
    set i 0
    return [jvalue $s i]
}

proc jskip {s iv} {
    upvar $iv i
    while {[string is space -strict [string index $s $i]]} {
        incr i
    }
}

proc jvalue {s iv} {
    upvar $iv i
    jskip $s i
    set c [string index $s $i]
    if {$c eq "\{"} {
        incr i
        set d [dict create]
        jskip $s i
        if {[string index $s $i] eq "\}"} {
            incr i
            return $d
        }
        while 1 {
            jskip $s i
            set k [jstring $s i]
            jskip $s i
            incr i ;# the colon
            dict set d $k [jvalue $s i]
            jskip $s i
            set c [string index $s $i]
            incr i
            if {$c ne ","} {
                return $d
            }
        }
    }
    if {$c eq "\["} {
        incr i
        set l {}
        jskip $s i
        if {[string index $s $i] eq "\]"} {
            incr i
            return $l
        }
        while 1 {
            lappend l [jvalue $s i]
            jskip $s i
            set c [string index $s $i]
            incr i
            if {$c ne ","} {
                return $l
            }
        }
    }
    if {$c eq "\""} {
        return [jstring $s i]
    }
    # a word: true, false, null or a number
    regexp -start $i {[a-z0-9.eE+-]+} $s w
    incr i [string length $w]
    return [string map {true 1 false 0 null 0} $w]
}

proc jstring {s iv} {
    upvar $iv i
    incr i ;# the opening quote
    set out ""
    while 1 {
        set c [string index $s $i]
        incr i
        if {$c eq "\"" || $c eq ""} {
            return $out
        }
        if {$c ne "\\"} {
            append out $c
            continue
        }
        set e [string index $s $i]
        incr i
        switch -- $e {
            n {append out \n}
            t {append out \t}
            r {append out \r}
            b {append out \b}
            f {append out \f}
            u {
                set hex [string range $s $i [expr {$i + 3}]]
                append out [format %c [scan $hex %x]]
                incr i 4
            }
            default {append out $e}
        }
    }
}

# -- writing: a string as JSON, and a message out

proc jstr {s} {
    set s [string map {\\ \\\\ \" \\\" \n \\n \r \\r \t \\t} $s]
    return "\"$s\""
}

proc say {line} {
    puts $line
    flush stdout
}

proc get {d k {def ""}} {
    if {[dict exists $d $k]} {
        return [dict get $d $k]
    }
    return $def
}

# -- the look: page.html's colours, and fm's marks after a name

wm title . fm
wm geometry . 760x560
wm protocol . WM_DELETE_WINDOW exit
ttk::style theme use clam
ttk::style configure Treeview -font {{Ubuntu Sans} 11} -rowheight 24 \
    -background #ffffff -fieldbackground #ffffff -foreground #1c211f \
    -borderwidth 0
ttk::style map Treeview -background {selected #fff4d6} \
    -foreground {selected #1c211f}
ttk::style configure TLabel -background #f5f6f4 -foreground #1c211f
ttk::style configure TFrame -background #f5f6f4
. configure -background #f5f6f4

ttk::label .head -anchor w -padding {12 8} -font {{Ubuntu Sans} 11 bold}
ttk::treeview .t -show tree -selectmode browse
ttk::frame .foot ;# the bottom line: the program's word, then the state
ttk::label .foot.word -anchor w -padding {12 6} -foreground #68716d
ttk::label .foot.state -anchor e -padding {12 6} -foreground #68716d
pack .foot.state -side right
pack .foot.word -side left -fill x -expand 1
ttk::frame .ask -padding {12 6}
ttk::label .ask.p
ttk::entry .ask.e
pack .ask.p -side left
pack .ask.e -side left -fill x -expand 1
grid .head -sticky ew
grid .t -sticky nsew
grid .foot -sticky ew
grid columnconfigure . 0 -weight 1
grid rowconfigure . 1 -weight 1

set font {{Ubuntu Sans} 11}
set fg {dir #2463c7 link #0f7c8c exec #2e8653 bad #c4332a}
foreach {kind colour} $fg {
    .t tag configure $kind -foreground $colour
}
.t tag configure sel -background #e5e8e4
.t tag configure inside -background #f8f6ef ;# a file's items, in the tree
# thumbs are drawn on a canvas, which takes the tree's place
canvas .c -background #ffffff -highlightthickness 0 -takefocus 1 \
    -yscrollincrement 24
# a program's text, as ed's buffer, is drawn as text in the terminal's font
set mono {{DejaVu Sans Mono} 11}
text .x -font $mono -wrap none -borderwidth 0 -highlightthickness 0 \
    -background #ffffff -foreground #1c211f -padx 12 -pady 6 \
    -insertwidth 0 -exportselection 0 -takefocus 1
.x tag configure picked -background #dbe4f0
.x tag configure cur -background #1c211f -foreground #ffffff
set marks {dir / link @ exec * bad @}

# -- what comes in

proc draw {d} {
    set ::last $d
    show
}

# show lays out the outline drawn last: zoomed, the cursor's folder alone;
# as the tree, every open folder from the top, nested
proc show {} {
    set top [get $::last tree]
    if {[get $top kind] eq "text"} {
        doc $top ;# a program's text, as ed's
        return
    }
    set in [zoom $top]
    if {$in eq ""} {
        set in $top
    }
    set shown $in
    if {$::tree} {
        set shown $top
    }
    set head [tilde [get $shown id]]
    wm title . $head
    .head configure -text $head
    .foot.word configure -text [get $::last status]
    set ::ids [dict create]
    set ::kinds [dict create]
    set ::more [dict create]
    set ::rows {}
    set ::cur -1
    set ::here 0
    set ::on .t
    grid remove .x
    if {$::lay eq "thumbs"} {
        set ::on .c
        grid remove .t
        grid .c -row 1 -column 0 -sticky nsew
        thumbs $in
    } else {
        grid remove .c
        grid .t -row 1 -column 0 -sticky nsew
        .t delete [.t children {}]
        rows $shown {}
        if {$::cur >= 0} {
            .t selection set r$::cur
            .t focus r$::cur
        }
    }
    if {$::cur < 0} {
        set ::cur $::here ;# an empty folder holds the cursor on its own row
    }
    if {[llength $::rows] > 0 && $::on eq ".t"} {
        .t see r$::cur
    }
    # the state: the program's words, then the window's own, its layout and
    # where the cursor is
    set mine [expr {$::lay eq "" ? "folder" : $::lay}]
    if {[llength $::rows] > 0} {
        append mine " [expr {$::cur + 1}]/[llength $::rows]"
    }
    if {[llength [get $::last state]] > 0} {
        set mine "[join [get $::last state] " "] · $mine"
    }
    .foot.state configure -text $mine
    if {!$::asking} {
        focus $::on
    }
}

# doc shows a program's text, as ed's buffer: its lines in the terminal's
# font, and in them the selection and the cursor, a block, or a bar in
# insert mode; the path on top, and on the bottom line the program's word,
# its state, and where the cursor is, line:col. Every key is the
# program's: an editor's keys are its language
proc doc {n} {
    set ::on .x
    grid remove .t
    grid remove .c
    grid .x -row 1 -column 0 -sticky nsew
    set head [tilde [get $n text]]
    wm title . $head
    .head configure -text $head
    .foot.word configure -text [get $::last status]
    set state [get $::last state]
    set bar [expr {[lindex $state 0] eq "insert"}]
    .x delete 1.0 end
    set at 1.0
    set i 0
    foreach k [get $n kids] {
        incr i
        set runs [get $k kids]
        if {[llength $runs] == 0} {
            .x insert end [get $k text]
        }
        set col 0
        foreach r $runs {
            set t [get $r text]
            set tags [expr {[get $r sel 0] ? "picked" : ""}]
            if {$t eq "\n"} {
                set t " " ;# a selected line break
            }
            if {[get $r cur 0]} {
                set at $i.$col
                if {!$bar} {
                    if {$t eq ""} {
                        set t " " ;# past the line's end
                    }
                    .x insert end [string index $t 0] [concat $tags cur]
                    set t [string range $t 1 end]
                    incr col
                }
            }
            .x insert end $t $tags
            incr col [string length $t]
        }
        .x insert end \n
    }
    .x configure -insertwidth [expr {$bar ? 2 : 0}]
    .x mark set insert $at
    .x see $at
    lassign [split $at .] line col
    set mine "$line:[expr {$col + 1}]"
    if {[llength $state] > 0} {
        set mine "[join $state " "] · $mine"
    }
    .foot.state configure -text $mine
    if {!$::asking} {
        focus .x
    }
}

# tilde is path p with the home folder said as ~
proc tilde {p} {
    set home $::env(HOME)
    if {$p eq $home || [string first $home/ $p] == 0} {
        return ~[string range $p [string length $home] end]
    }
    return $p
}

# thumbs lays out n's kids as a grid read left to right, each card as wide
# as the widest caption, up to 240 pixels, the cursor's line kept in sight
proc thumbs {n} {
    .c delete all
    set ::cw 0
    foreach k [get $n kids] {
        set ::cw [expr {max($::cw, [font measure $::font [caption $k]])}]
    }
    set ::cw [expr {min($::cw, 240) + 32}]
    set ::cols [expr {max(1, [winfo width .c] / $::cw)}]
    foreach k [get $n kids] {
        set i [llength $::rows]
        set kind [get $k kind file]
        set x [expr {$i % $::cols * $::cw}]
        set y [expr {$i / $::cols * 24}]
        set bg ""
        if {[get $k cur 0]} {
            set ::cur $i
            set bg #fff4d6
        } elseif {[get $k sel 0]} {
            set bg #e5e8e4
        }
        if {$bg ne ""} {
            .c create rectangle [expr {$x + 4}] $y [expr {$x + $::cw - 4}] \
                [expr {$y + 24}] -fill $bg -outline ""
        }
        .c create text [expr {$x + 16}] [expr {$y + 12}] -anchor w \
            -text [fit [caption $k] 240] -font $::font \
            -fill [get $::fg $kind #1c211f]
        dict set ::ids r$i [get $k id]
        dict set ::kinds r$i $kind
        dict set ::more r$i [llength [get $k kids]]
        lappend ::rows [get $k id]
    }
    set lines [expr {([llength $::rows] + $::cols - 1) / $::cols}]
    .c configure -scrollregion [list 0 0 [winfo width .c] [expr {$lines * 24}]]
    if {$::cur >= 0} {
        set top [expr {max(0, $::cur / $::cols - $::page / 2)}]
        .c yview moveto [expr {$top / double(max(1, $lines))}]
    }
}

# caption is how node k reads: its text, its kind's mark, and … when it is
# shut with more inside
proc caption {k} {
    set s [get $k text][get $::marks [get $k kind file]]
    if {[llength [get $k kids]] && ![get $k open 0]} {
        append s " …"
    }
    return $s
}

# fit is s cut, … at its end, to about px pixels wide
proc fit {s px} {
    set w [font measure $::font $s]
    if {$w <= $px} {
        return $s
    }
    return [string range $s 0 [expr {[string length $s] * $px / $w - 2}]]…
}

# rows puts n's kids under row parent and, as the tree, under each open one
# its own
proc rows {n parent} {
    foreach k [get $n kids] {
        set i [llength $::rows]
        set kind [get $k kind file]
        set tags [list $kind]
        if {[get $k sel 0]} {
            lappend tags sel
        } elseif {$::tree && $kind eq "item" && ![get $k cur 0]} {
            lappend tags inside ;# set apart, as the terminal's bracket does
        }
        set more [llength [get $k kids]]
        set open [expr {$::tree && [get $k open 0]}]
        set name [caption $k]
        .t insert $parent end -id r$i -text $name -tags $tags -open $open
        dict set ::ids r$i [get $k id]
        dict set ::kinds r$i $kind
        dict set ::more r$i $more
        lappend ::rows [get $k id]
        if {[get $k cur 0]} {
            set ::cur $i
        } elseif {[get $k in 0]} {
            set ::here $i
        }
        if {$open} {
            rows $k r$i
        }
    }
}

# zoom is the node the cursor is among the kids of, else empty
proc zoom {n} {
    if {[get $n in 0]} {
        return $n
    }
    foreach k [get $n kids] {
        set z [zoom $k]
        if {$z ne ""} {
            return $z
        }
    }
    return ""
}

set last {}
set on .t  ;# the widget showing: .t the list, .c thumbs, .x text
set lay {} ;# the layout: {} the cursor's folder, tree, or thumbs
set tree 0 ;# laid out as the tree
set rows {}
set cur 0
set page 20
set cols 1 ;# cards a line
set cw 1   ;# a card's width

set asking 0

proc ask {d} {
    set ::asking 1
    .ask.p configure -text [get $d prompt]
    .ask.e delete 0 end
    .ask.e insert 0 [get $d def]
    grid remove .foot
    grid .ask -row 2 -column 0 -sticky ew
    focus .ask.e
}

# -- what goes out

proc answer {text ok} {
    set ::asking 0
    grid remove .ask
    grid .foot
    focus $::on
    set ok [expr {$ok ? "true" : "false"}]
    say "{\"answer\":{\"text\":[jstr $text],\"ok\":$ok}}"
}

proc key {name {node ""} {text ""}} {
    if {$::asking || ($name eq "" && $node eq "")} {
        return
    }
    set k "\"name\":[jstr $name],\"node\":[jstr $node]"
    if {$text ne ""} {
        append k ",\"text\":[jstr $text]"
    }
    say "{\"key\":{$k}}"
}

# pasted sends what is on the clipboard, or the selection a middle click
# brings, as one key, PASTE, the way a terminal's bracketed paste comes
proc pasted {which} {
    if {$::on ne ".x" || [catch {selection get -selection $which} text]} {
        return
    }
    key PASTE "" $text
}

# a move among the rows is the window's own: down, up, the last, a page,
# and as thumbs right and left, down and up going a line of cards; the
# program hears only where the cursor landed
proc move {name} {
    set n [llength $::rows]
    set step [expr {$::lay eq "thumbs" ? $::cols : 1}]
    switch -- $name {
        j - DOWN {set d $step}
        k - UP {set d [expr {-$step}]}
        PGDN {set d [expr {$::page * $step}]}
        PGUP {set d [expr {-$::page * $step}]}
        G {set d $n}
        RIGHT - LEFT {
            if {$::lay ne "thumbs"} {
                return 0
            }
            set d [expr {$name eq "RIGHT" ? 1 : -1}]
        }
        default {return 0}
    }
    if {$n > 0} {
        key "" [lindex $::rows [expr {max(0, min($::cur + $d, $n - 1))}]]
    }
    return 1
}

# folds is whether key name opens or closes row r in place: enter and
# right do on a folder or an item with kids, and right on a file too,
# asking the program for its items. Enter on a file, or on an item with no
# kids, is the program's: it edits
proc folds {r name} {
    set kind [dict get $::kinds $r]
    if {$kind eq "item" && [dict get $::more $r] == 0} {
        return 0
    }
    return [expr {$kind in {dir item} || $name eq "RIGHT"}]
}

# going in and out in the tree is the window's own: enter and right open or
# close a row that folds, asking the program for what is inside; left and
# h close what is open, else go up to the node the row is in. Zoomed, and
# at the top, the key is the program's
proc turn {name} {
    if {!$::tree || [llength $::rows] == 0} {
        return 0
    }
    set r r$::cur
    set id [dict get $::ids $r]
    set open [.t item $r -open]
    switch -- $name {
        ENTER - RIGHT {
            if {![folds $r $name]} {
                return 0
            }
            key [expr {$open ? "close" : "open"}] $id
        }
        LEFT - h {
            if {$open} {
                key close $id
            } elseif {[.t parent $r] ne ""} {
                key "" [dict get $::ids [.t parent $r]]
            } else {
                return 0
            }
        }
        default {
            return 0
        }
    }
    return 1
}

# a key pressed: t turns to the next layout, the tree, thumbs, the folder; a
# move or a turn is the window's own, else the key is the program's. A
# window shows no row numbers, so digits jump nowhere
proc pressed {name} {
    if {$::asking} {
        return
    }
    if {$::on eq ".x"} {
        key $name ;# an editor's keys are its language
        return
    }
    if {$name eq "t"} {
        set ::lay [dict get {{} tree tree thumbs thumbs {}} $::lay]
        set ::tree [expr {$::lay eq "tree"}]
        show
    } elseif {![move $name] && ![turn $name] &&
              ![string match {[0-9]} $name]} {
        key $name
    }
}

# a key as tty names it: a named key, else the letter it types
proc keyname {sym ch} {
    set named {Return ENTER Escape ESC Tab TAB BackSpace BACKSPACE
        Up UP Down DOWN Left LEFT Right RIGHT Prior PGUP Next PGDN}
    if {[dict exists $named $sym]} {
        return [dict get $named $sym]
    }
    if {$ch eq "\x03"} {
        return INT ;# ctrl-c, as tty names it
    }
    if {[string length $ch] == 1 && [string is print $ch]} {
        return $ch
    }
    return ""
}

# a click puts the cursor on a row; a double click is enter there, which in
# the tree opens or closes a row that folds
proc clicked {x y name} {
    set r [.t identify item $x $y]
    if {$r eq ""} {
        return
    }
    if {$name eq "ENTER" && $::tree && [folds $r ENTER]} {
        set name [expr {[.t item $r -open] ? "close" : "open"}]
    }
    key $name [dict get $::ids $r]
}

# tapped is a click on the thumbs: the cursor goes to the card there, and a
# double click is enter on it
proc tapped {x y name} {
    set x [.c canvasx $x]
    set y [.c canvasy $y]
    set i [expr {int($y) / 24 * $::cols + int($x) / $::cw}]
    if {$x < $::cols * $::cw && $i < [llength $::rows]} {
        key $name [lindex $::rows $i]
    }
}

bindtags .t {.t . all} ;# the tree's own keys are the program's
bindtags .c {.c . all}
bind .c <ButtonRelease-1> {tapped %x %y ""}
bind .c <Double-1> {tapped %x %y ENTER}
bind .c <Button-4> {.c yview scroll -1 units}
bind .c <Button-5> {.c yview scroll 1 units}
bind .c <MouseWheel> {.c yview scroll [expr {-%D / 120}] units}
bind .c <Configure> {if {$lay eq "thumbs"} show}

# sized says how much the text shows, as a terminal would: columns, and
# rows with one more for the bottom line
proc sized {w h} {
    set cols [expr {($w - 24) / [font measure $::mono 0]}]
    set rows [expr {($h - 12) / [font metrics $::mono -linespace] + 1}]
    say "{\"size\":{\"w\":$cols,\"h\":$rows}}"
}

bindtags .x {.x . all} ;# every key in the text is the program's
bind .x <Button-4> {.x yview scroll -3 units}
bind .x <Button-5> {.x yview scroll 3 units}
bind .x <MouseWheel> {.x yview scroll [expr {-%D / 40}] units}
bind .x <ButtonRelease-2> {pasted PRIMARY}
bind . <Control-V> {pasted CLIPBOARD} ;# ctrl-shift-v, as in a terminal
bind .x <Configure> {sized %w %h}
bind . <Key> {pressed [keyname %K %A]}
bind .t <ButtonRelease-1> {clicked %x %y ""}
bind .t <Double-1> {clicked %x %y ENTER}
bind .t <Button-4> {.t yview scroll -3 units}
bind .t <Button-5> {.t yview scroll 3 units}
bind .t <MouseWheel> {.t yview scroll [expr {-%D / 40}] units}
bind .ask.e <Return> {answer [.ask.e get] 1; break}
bind .ask.e <Escape> {answer "" 0; break}
bind .t <Configure> {
    set page [expr {max(1, %h / 24)}]
    say "{\"size\":{\"w\":[expr {%w / 8}],\"h\":[expr {$page + 3}]}}"
}

fconfigure stdin -encoding utf-8 -blocking 0
fconfigure stdout -encoding utf-8
fileevent stdin readable {
    if {[gets stdin line] < 0} {
        if {[eof stdin]} {
            exit
        }
        return
    }
    set m [json $line]
    if {[dict exists $m draw]} {
        draw [dict get $m draw]
    }
    if {[dict exists $m ask]} {
        ask [dict get $m ask]
    }
    if {[dict exists $m copy]} {
        clipboard clear
        clipboard append -- [get [dict get $m copy] text]
    }
}
focus .t
