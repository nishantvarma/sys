#!/usr/bin/env python3
"""a todo folder as a page, or as its walk. design/todo is the model: the
folder is the data, and what this makes from it is never edited.

    medium/page/todo FOLDER [TEMPLATE] > page.html
    medium/page/todo -w FOLDER [TEMPLATE]    writes the pages; a path a line
    medium/page/todo -t FOLDER               the walk; a node a line

-w writes FOLDER's page, then remakes the page of each todo/ it reaches that
has one already; a first page is made with -w on its own folder. a folder's
page is its index.html if it has one, else, for a folder named todo,
todo.html beside it, which takes the parent's name and opens with the lead
of the parent's readme. TEMPLATE defaults to the page being written, else
the medium's page.html.

-t prints the nodes in the order they are done: the state, the title
indented by depth, and the id, the path down, which is its address on the
page.

check: node medium/page/run.mjs page.html, on the page it made
"""

import argparse
import html
import os
import re
import sys
from collections import Counter
from dataclasses import dataclass, field
from pathlib import Path

STATES = ("now", "open", "fail", "blocked", "todo", "done")
SMALL = {
    "a",
    "an",
    "and",
    "as",
    "at",
    "but",
    "by",
    "for",
    "in",
    "of",
    "on",
    "or",
    "the",
    "to",
    "vs",
    "with",
}
ACRONYMS = {"db": "DB", "html": "HTML", "id": "ID", "mrs": "MRs", "ui": "UI"}
# a folder's files a reader opens, by suffix; "" is a note or a script
READ = {"", ".htm", ".html", ".md", ".pdf", ".txt", ".url"}
META = re.compile(r"^(title|state|after):[ \t]*(.*?)[ \t]*$")
STEP = re.compile(r"^\s*[-*] \[([ xX])\] ", re.MULTILINE)
TITLE = re.compile(r"^#*\s*(.*?)(?: -- | — |$)")


@dataclass
class Entry:
    id: str
    title: str = ""
    state: str = "todo"
    after: list[str] = field(default_factory=list)
    text: str = ""
    files: list[Path] = field(default_factory=list)
    tally: str = ""
    is_dir: bool = False
    children: list["Entry"] = field(default_factory=list)
    todo: Path | None = None  # the folder the children come from


# -- the entries --


def slug(name: str) -> str:
    """an id: lower case, each other run a dash. page/list has the same, so
    the list and the page join on it."""
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")


def entries(
    folder: Path, seen: set[Path] | None = None, numbered: bool = False
) -> dict[str, Entry]:
    """the folder's entries by id, each with what its text says; with
    numbered, only those whose names are, as a folder's own nodes are.
    seen is the folders already read above this one, so a link cannot
    cycle."""
    seen = (seen or set()) | {folder.resolve()}
    found: dict[str, Entry] = {}
    for path in sorted(folder.iterdir()):
        if path.name.startswith(".") or path.name == "index.html":
            continue
        if numbered and not re.match(r"\d+-", path.name):
            continue
        e = entry(path, seen)
        if e.id in found:
            sys.exit(f"{path.name}: {e.id} is already an entry")
        found[e.id] = e
    for e in found.values():
        check(e, found)
    return found


def head(text: str) -> tuple[dict[str, str], str]:
    """the head lines (key: value, in the first 40) out of a text; the rest
    is the body."""
    meta: dict[str, str] = {}
    body = []
    for n, line in enumerate(text.splitlines()):
        found = META.match(line) if n < 40 else None
        if found:
            meta.setdefault(found[1], found[2])
        else:
            body.append(line)
    return meta, "\n".join(body).strip()


def entry(path: Path, seen: set[Path]) -> Entry:
    name = re.sub(r"^\d+-|\.html?$", "", path.name)
    text, files = load(path)
    meta, text = head(text)
    first = TITLE.match(text.split("\n")[0])[1] if text else ""
    target = path.resolve()
    if target.is_dir():
        text = lead(text)
    # a folder's nodes are its numbered entries, as tangle reads a
    # folder; a project's, whose own files are not the todo's, its todo/
    todo = target / "todo"
    home = todo if todo.is_dir() else target
    children = (
        list(entries(home, seen, numbered=home == target).values())
        if target.is_dir() and home.resolve() not in seen
        else []
    )
    # a node with nodes counts them; only one without reads a page, its own
    # or the one it names
    held = counted(children) if children else states(target)
    return Entry(
        id=slug(name),
        title=meta.get("title") or first or re.sub(r"[-_]", " ", name),
        state=meta.get("state")
        or next((s for s in STATES if held[s]), "todo"),
        after=meta.get("after", "").replace(",", " ").split(),
        text=text,
        files=files,
        tally=tally(held),
        is_dir=target.is_dir(),
        children=children,
        todo=todo if children and home == todo else None,
    )


def lead(text: str) -> str:
    """the first paragraph of a folder's readme: its heading line dropped,
    then to the first blank. the rest is the folder's, not the card's."""
    lines = text.splitlines()
    if lines and lines[0].startswith("#"):
        lines = lines[1:]
    para = []
    for line in lines:
        if not line.strip():
            if para:
                break
            continue
        para.append(line)
    return "\n".join(para)


def states(target: Path) -> Counter:
    """the states a todo page holds: a folder's own index.html or todo.html,
    or the page a link names."""
    if target.is_dir():
        page = next(
            (
                p
                for p in (target / "index.html", target / "todo.html")
                if p.is_file() and not p.is_symlink()
            ),
            None,
        )
    else:
        page = target if target.suffix in (".htm", ".html") else None
    if not page or not page.is_file():
        return Counter()
    return Counter(re.findall(r'data-state="(\w+)"', page.read_text()))


def counted(children: list[Entry]) -> Counter:
    """the states of the nodes under a node, at every depth: what its card
    counts, taken from the folders and never from a page made of them."""
    held: Counter = Counter()
    for c in children:
        held[c.state] += 1
        held.update(counted(c.children))
    return held


def tally(held: Counter) -> str:
    """a page's states as a line: 4 of 13 done · 1 now · 8 todo."""
    if not held:
        return ""
    rest = [
        f"{held[s]} {s}"
        for s in STATES
        if held[s] and s not in ("todo", "done")
    ]
    return " · ".join(
        [
            f"{held['done']} of {held.total()} done",
            *rest,
            f"{held['todo']} todo",
        ]
    )


def load(path: Path) -> tuple[str, list[Path]]:
    """the text of an entry, and the files that are links: what a reader
    opens. a page's assets (css, js, images) are not listed."""
    target = path.resolve()
    if target.is_dir():
        readme = next(
            (f for f in (target / "README", target / "readme") if f.is_file()),
            None,
        )
        files = [
            f
            for f in sorted(target.iterdir())
            if f != readme
            and not f.name.startswith(".")
            and (f.is_dir() or f.suffix.lower() in READ)
        ]
        return (readme.read_text() if readme else ""), files
    try:
        return (
            ("", [path])
            if target.suffix == ".html"
            else (target.read_text(), [])
        )
    except UnicodeDecodeError:
        return "", [path]


def check(e: Entry, found: dict[str, Entry]):
    """what a typed state or an after gets wrong, said on stderr."""
    if e.state not in STATES:
        print(f"{e.id}: state {e.state} is none of {STATES}", file=sys.stderr)
    if e.after and e.state != "blocked":
        print(
            f"{e.id}: after names entries, but state is not blocked",
            file=sys.stderr,
        )
    for name in e.after:
        if name not in found:
            print(f"{e.id}: after {name} is no entry", file=sys.stderr)


# -- the page --


def headline(title: str) -> str:
    """title case; a word with a capital, digit, dot or slash is as typed."""

    def word(i: int, w: str) -> str:
        if w.lower() in ACRONYMS:
            return ACRONYMS[w.lower()]
        if re.search(r"[A-Z0-9./~]", w):
            return w
        return (
            w
            if i and w in SMALL
            else re.sub(r"[a-z]", lambda m: m[0].upper(), w, count=1)
        )

    return " ".join(word(i, w) for i, w in enumerate(title.split()))


def esc(text: str) -> str:
    return html.escape(text, quote=False)


SEP = re.compile(r"^\s*([-=~_])\1{2,}\s*$")


def leaves(text: str) -> str:
    """a note's body as html, studio/markup's first leaves: a paragraph
    flows, its hard-wrapped lines joined; a run of "- " lines is a list,
    "- [ ]" and "- [x]" its steps, an indented line continues the item
    above; an aligned block (columns, a diagram) stays as typed, a pre;
    a rule line only parts blocks."""
    out: list[str] = []
    para: list[str] = []
    items: list[str] = []

    def flush_para():
        if para:
            if any(
                "  " in line or line.startswith((" ", "\t")) for line in para
            ):
                out.append(f"<pre>{esc(chr(10).join(para))}</pre>")
            else:
                out.append(
                    "<p>" + esc(" ".join(l.strip() for l in para)) + "</p>"
                )
            para.clear()

    def flush_items():
        if items:
            lis = []
            for it in items:
                step = re.match(r"\[([ xX])\] (.*)", it, re.DOTALL)
                if step:
                    cls = (
                        ' class="step done"'
                        if step[1] != " "
                        else ' class="step"'
                    )
                    lis.append(f"<li{cls}>{esc(step[2])}</li>")
                else:
                    lis.append(f"<li>{esc(it)}</li>")
            out.append("<ul>" + "".join(lis) + "</ul>")
            items.clear()

    for line in text.splitlines():
        if not line.strip() or SEP.match(line):
            flush_para()
            flush_items()
        elif line.startswith("- "):
            flush_para()
            items.append(line[2:])
        elif line.startswith(" ") and items:
            items[-1] += " " + line.strip()
        else:
            flush_items()
            para.append(line)
    flush_para()
    flush_items()
    return "\n".join(out)


def lede(e: Entry) -> str:
    """the first line of prose, to read on a folded card."""
    lines = (
        line.removeprefix(e.title).strip(" -—=#")
        for line in e.text.splitlines()
    )
    first = e.tally or next(filter(None, lines), "")
    return f'<span class="lede">{esc(first[:110])}</span>' if first else ""


def node(e: Entry, at: Path, found: dict[str, Entry], prefix: str = "") -> str:
    """an entry as a node: heading and pill, then body. a child's id and
    after links are prefixed by the path down to it: proj/task. at is the
    folder the page is written in, which its links are relative to."""
    steps = STEP.findall(e.text)
    done = len(steps) - steps.count(" ")
    links = [
        f'<a href="{os.path.relpath(f, at)}"><code>{esc(f.name)}</code></a>'
        for f in e.files
    ]
    after = [
        f'<a href="#{prefix}{a}">{esc(headline(found[a].title))}</a>'
        if a in found
        else esc(a)
        for a in e.after
    ]
    sibs = {c.id: c for c in e.children}
    children = [node(c, at, sibs, f"{prefix}{e.id}/") for c in e.children]
    # a folder's readme gives its lead, on top; a note's text is the body.
    # a folder's files are the explorer's lens, not the todo's: only a
    # link entry keeps its link, where the link is the entry itself
    block = leaves(e.text) if e.text else ""
    body = [
        block if e.is_dir else "",
        f"<p>{e.tally}</p>" if e.tally else "",
        *children,
        '<p class="files">' + " · ".join(links) + "</p>"
        if links and not e.is_dir
        else "",
        f"<p>{done} of {len(steps)} steps</p>" if steps else "",
        "" if e.is_dir else block,
        f"<p>after: {', '.join(after)}</p>" if after else "",
    ]
    body = [part for part in body if part]
    inner = "\n<div>\n" + "\n".join(body) + "\n</div>" if body else ""
    return (
        f'<details id="{prefix}{e.id}" data-state="{e.state}">\n'
        f"<summary><h2>{esc(headline(e.title))}</h2>"
        f'<span class="pill">{e.state}</span>{lede(e)}</summary>{inner}\n'
        "</details>"
    )


def walk(found, prefix: str = "", depth: int = 0) -> list[str]:
    """the nodes in the order they are done, a line each: the state, the
    title indented by depth, the id, and the tally where there is one. the
    order is the names'; a state marks a node and never moves it."""
    lines = []
    for e in found:
        tally = f"  {e.tally}" if e.tally else ""
        lines.append(
            f"{e.state:<8}{'  ' * depth}{e.title}  ({prefix}{e.id}){tally}"
        )
        lines += walk(e.children, f"{prefix}{e.id}/", depth + 1)
    return lines


def page(folder: Path, template: str) -> str:
    """the template, with the folder's entries as main, in the order of
    their names. a folder named todo is a project's own todo: the page takes
    the parent's name and opens with the lead of the parent's readme."""
    found = entries(folder)
    here = folder.resolve()
    at = where(here).parent
    says = ""
    if here.name == "todo":
        title = f"{here.parent.name} todo"
        readme = next(
            (
                p
                for p in (here.parent / "README", here.parent / "readme")
                if p.is_file()
            ),
            None,
        )
        if readme:
            says = lead(head(readme.read_text())[1])
    else:
        title = here.name
    lead_div = (
        f'<div class="lead">\n<p>{esc(says)}</p>\n</div>\n' if says else ""
    )
    main = (
        f'<main class="tiles">\n<h1>{esc(title)}</h1>\n'
        + lead_div
        + "\n".join(
            '<div class="tile">\n' + node(e, at, found) + "\n</div>"
            for e in found.values()
        )
        + "\n</main>"
    )
    return re.sub(
        r"^([ \t]*)<main\b[^>]*>.*</main>",
        lambda m: m[1] + main,
        template,
        flags=re.MULTILINE | re.DOTALL,
    )


# -- the files --


def where(folder: Path) -> Path:
    """a folder's page: its own index.html, else, for a folder named todo,
    todo.html beside it."""
    inside = folder / "index.html"
    if folder.name == "todo" and not inside.exists():
        return folder.with_name("todo.html")
    return inside


def homes(found) -> list[Path]:
    """the todo/ folders the nodes take their children from, at every
    depth."""
    out = []
    for e in found:
        if e.todo:
            out.append(e.todo)
        out += homes(e.children)
    return out


def skeleton(out: Path, template: Path | None) -> str:
    """what a page is made on: the template named, else the page itself,
    else the medium's page.html."""
    if template:
        return template.read_text()
    if out.exists():
        return out.read_text()
    return (Path(__file__).resolve().parent.parent / "page.html").read_text()


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("folder", type=Path)
    parser.add_argument("template", type=Path, nargs="?")
    parser.add_argument("-w", action="store_true", help="write the pages")
    parser.add_argument("-t", action="store_true", help="print the walk")
    args = parser.parse_args()
    folder = args.folder.resolve()
    if args.t:
        print("\n".join(walk(entries(folder).values())))
        return
    if not args.w:
        out = where(folder)
        sys.stdout.write(page(folder, skeleton(out, args.template)))
        return
    # the folder's page, then each page under it that is there already
    under = homes(entries(folder).values())
    for f in [folder, *(h for h in under if where(h).exists())]:
        out = where(f)
        out.write_text(page(f, skeleton(out, args.template)))
        print(out)


if __name__ == "__main__":
    main()
